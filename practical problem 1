      ],
      "source": [
        "data = [\n",
        "        ['Sunny','Warm','Normal','Strong','Warm','Same','Yes'],\n",
        "        ['Sunny','Warm','High','Strong','Warm','Same','Yes'],\n",
        "        ['Rainy','Cold','High','Strong','Warm','Change','No'],\n",
        "        ['Sunny','Warm','High','Strong','Cool','Change','Yes'],\n",
        "       ]\n",
        "h = ['0','0','0','0','0','0']\n",
        "print(\"Start h:\", h)\n",
        "\n",
        "for row in data:\n",
        "    x = row[0:6]\n",
        "    label = row[6]\n",
        "    if label == 'Yes':\n",
        "        for i in range(6):\n",
        "            if h[i] == '0':\n",
        "                h[i] = x[i]\n",
        "            elif h[i] != x[i]:\n",
        "               h[i] = '?'\n",
        "        print(\"Positive ->\", h)\n",
        "    else:\n",
        "        print(\"Negative -> ignore\", h)\n",
        "    print(\"Final h:\", h)\n"
      ]
