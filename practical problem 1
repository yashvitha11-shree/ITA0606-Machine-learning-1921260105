            "Negative -> ignore ['Sunny', 'Warm', '?', 'Strong', 'Warm', 'Same']\n",
            "Final h: ['Sunny', 'Warm', '?', 'Strong', 'Warm', 'Same']\n",
            "Positive -> ['Sunny', 'Warm', '?', 'Strong', '?', '?']\n",
