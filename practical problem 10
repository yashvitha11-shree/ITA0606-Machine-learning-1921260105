        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.mixture import GaussianMixture\n",
        "from sklearn.datasets import make_blobs\n",
        "\n",
        "# 1. Generate synthetic clustered data (2D)\n",
        "np.random.seed(42)\n",
        "X, _ = make_blobs(n_samples=300, centers=3, cluster_std=1.2, random_state=42)\n",
        "\n",
        "# 2. Initialize and fit the Gaussian Mixture Model (uses the EM algorithm)\n",
        "gmm = GaussianMixture(n_components=3, covariance_type='full', random_state=42)\n",
        "gmm.fit(X)\n",
        "\n",
        "# 3. Predict cluster assignments and probabilities\n",
        "labels = gmm.predict(X)\n",
        "probs = gmm.predict_proba(X)\n",
        "\n",
        "# 4. Print learned parameters\n",
        "print(\"Converged:\", gmm.converged_)\n",
        "print(\"Number of EM iterations:\", gmm.n_iter_)\n",
        "print(\"\\nCluster Means:\\n\", gmm.means_)\n",
        "print(\"\\nCluster Weights:\\n\", gmm.weights_)\n",
        "\n",
        "# 5. Visualize the clusters and their centers\n",
        "plt.figure(figsize=(8, 6))\n",
        "plt.scatter(X[:, 0], X[:, 1], c=labels, cmap='viridis', s=40, alpha=0.7, label='Data Points')\n",
        "plt.scatter(gmm.means_[:, 0], gmm.means_[:, 1], c='red', marker='X', s=200, label='Cluster Centers (Means)')\n",
        "plt.title('Expectation-Maximization (GMM Clustering)')\n",
        "plt.xlabel('Feature 1')\n",
        "plt.ylabel('Feature 2')\n",
        "plt.legend()\n",
        "plt.grid(True)\n",
        "plt.show()"
      ]
