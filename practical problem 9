        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.linear_model import LinearRegression\n",
        "from sklearn.preprocessing import PolynomialFeatures\n",
        "from sklearn.metrics import mean_squared_error, r2_score\n",
        "\n",
        "# 1. Generate synthetic non-linear dataset\n",
        "np.random.seed(42)\n",
        "X = np.sort(6 * np.random.rand(80, 1) - 3, axis=0)\n",
        "y = 0.5 * X**2 + X + 2 + np.random.randn(80, 1) * 0.8\n",
        "\n",
        "# 2. Fit Linear Regression Model\n",
        "lin_reg = LinearRegression()\n",
        "lin_reg.fit(X, y)\n",
        "y_pred_lin = lin_reg.predict(X)\n",
        "\n",
        "# 3. Fit Polynomial Regression Model (Degree = 2)\n",
        "poly_features = PolynomialFeatures(degree=2, include_bias=False)\n",
        "X_poly = poly_features.fit_transform(X)\n",
        "\n",
        "poly_reg = LinearRegression()\n",
        "poly_reg.fit(X_poly, y)\n",
        "y_pred_poly = poly_reg.predict(X_poly)\n",
        "\n",
        "# 4. Compare Performance Metrics\n",
        "print(\"--- Linear Regression ---\")\n",
        "print(f\"MSE: {mean_squared_error(y, y_pred_lin):.4f}\")\n",
        "print(f\"R2 Score: {r2_score(y, y_pred_lin):.4f}\\n\")\n",
        "\n",
        "print(\"--- Polynomial Regression (Degree 2) ---\")\n",
        "print(f\"MSE: {mean_squared_error(y, y_pred_poly):.4f}\")\n",
        "print(f\"R2 Score: {r2_score(y, y_pred_poly):.4f}\")\n",
        "\n",
        "# 5. Visualize the Comparison\n",
        "plt.figure(figsize=(9, 6))\n",
        "plt.scatter(X, y, color='gray', alpha=0.7, label='Actual Data')\n",
        "plt.plot(X, y_pred_lin, color='red', linewidth=2, label='Linear Regression')\n",
        "plt.plot(X, y_pred_poly, color='blue', linewidth=2, label='Polynomial Regression (Degree 2)')\n",
        "plt.title('Linear vs. Polynomial Regression')\n",
        "plt.xlabel('Feature (X)')\n",
        "plt.ylabel('Target (y)')\n",
        "plt.legend()\n",
        "plt.grid(True)\n",
        "plt.show()"
      ]
