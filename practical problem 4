        "# Lab 4 - ANN with Backpropagation\n",
        "import numpy as np\n",
        "from sklearn.neural_network import MLPClassifier\n",
        "from sklearn.metrics import accuracy_score\n",
        "\n",
        "# Dataset - XOR Problem (best for Backprop demo)\n",
        "# X1, X2 -> Y\n",
        "X = [[0,0],[0,1],[1,0],[1,1]]\n",
        "y = [0,1,1,0]\n",
        "\n",
        "# MLP = Artificial Neural Network, algorithm='backprop' inside\n",
        "model = MLPClassifier(hidden_layer_sizes=(4,), activation='logistic', max_iter=5000, random_state=1)\n",
        "model.fit(X, y)\n",
        "\n",
        "print(\"Predictions:\", model.predict(X))\n",
        "print(\"Accuracy:\", accuracy_score(y, model.predict(X))*100, \"%\")\n",
        "\n",
        "# Test New Sample\n",
        "print(\"Test [0,1] ->\", model.predict([[0,1]]))\n",
        "print(\"Test [1,1] ->\", model.predict([[1,1]]))\n",
        "print(\"Loss (Error) :\", model.loss_)"
      ]
