        "import pandas as pd\n",
        "import numpy as np\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.ensemble import RandomForestClassifier\n",
        "from sklearn.metrics import accuracy_score, classification_report, confusion_matrix\n",
        "\n",
        "# 1. Create a sample dataset representing customer financial profiles\n",
        "data = {\n",
        "    'Annual_Income': [50000, 120000, 30000, 85000, 45000, 150000, 25000, 95000, 60000, 110000, 35000, 75000],\n",
        "        'Monthly_Debt': [1200, 1500, 1800, 1000, 1400, 1200, 1600, 1100, 1300, 1400, 1700, 900],\n",
        "            'Num_Credit_Cards': [3, 4, 2, 3, 2, 5, 1, 4, 3, 4, 2, 3],\n",
        "                'Delayed_Payments': [2, 0, 5, 1, 3, 0, 6, 0, 2, 1, 4, 1],\n",
        "                    'Credit_Utilization': [45.0, 20.5, 78.0, 30.0, 55.2, 15.0, 85.5, 25.0, 40.0, 22.0, 68.0, 28.5],\n",
        "                        'Credit_Score': ['Standard', 'Good', 'Poor', 'Good', 'Standard', 'Good', 'Poor', 'Good', 'Standard', 'Good', 'Poor', 'Good']\n",
        "                        }\n",
        "df = pd.DataFrame(data)\n",
        "\n",
        "                        # 2. Separate features (X) and target label (y)\n",
        "X = df.drop('Credit_Score', axis=1)\n",
        "y = df['Credit_Score']\n",
        "\n",
        "                        # 3. Split the dataset into training (75%) and testing (25%) sets\n",
        "X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.25, random_state=42)\n",
        "\n",
        "                        # 4. Initialize and train the Random Forest Classifier\n",
        "model = RandomForestClassifier(n_estimators=100, random_state=42)\n",
        "model.fit(X_train, y_train)\n",
        "\n",
        "                        # 5. Evaluate the model on the test set\n",
        "y_pred = model.predict(X_test)\n",
        "print(f\"Model Accuracy: {accuracy_score(y_test, y_pred) * 100:.2f}%\\n\")\n",
        "print(\"Classification Report:\\n\", classification_report(y_test, y_pred, zero_division=0))\n",
        "\n",
        "                        # 6. Predict Credit Score for a new customer\n",
        "                        # [Annual_Income, Monthly_Debt, Num_Credit_Cards, Delayed_Payments, Credit_Utilization]\n",
        "new_customer = pd.DataFrame([[90000, 1000, 3, 0, 24.0]], columns=X.columns)\n",
        "prediction = model.predict(new_customer)\n",
        "print(f\"Predicted Credit Score for New Customer: {prediction[0]}\")"
      ]
