        "# Lab 15 - Iris Classification - Naive Bayes\n",
        "from sklearn.datasets import load_iris\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.naive_bayes import GaussianNB\n",
        "from sklearn.metrics import confusion_matrix, accuracy_score\n",
        "\n",
        "# Inbuilt Iris dataset - 150 flowers, 3 types\n",
        "iris = load_iris()\n",
        "X = iris.data\n",
        "y = iris.target\n",
        "\n",
        "X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.3, random_state=0)\n",
        "model = GaussianNB()\n",
        "model.fit(X_train, y_train)\n",
        "pred = model.predict(X_test)\n",
        "\n",
        "print(\"Accuracy:\", accuracy_score(y_test, pred)*100, \"%\")\n",
        "print(\"\\nConfusion Matrix:\\n\", confusion_matrix(y_test, pred))\n",
        "print(\"\\nTarget Names:\", iris.target_names)\n",
        "\n",
        "# New Flower: Sepal 5.1, 3.5, Petal 1.4, 0.2 -> Setosa\n",
        "print(\"New Flower [5.1,3.5,1.4,0.2] ->\", iris.target_names[model.predict([[5.1,3.5,1.4,0.2]])[0]])"
      ]
